+def configuration_proofs(module, binding, runner_source, frozen_source):
+    # Verify prescribed source policy without evaluating arbitrary source expressions.
+    expected = str(Path(binding['base_prefix'])/'bin')+':/usr/bin:/bin'
+    expressions = (
+        (runner_source, "str(Path(inputs['binding']['base_prefix'])/'bin')+':/usr/bin:/bin'"),
+        (frozen_source, "str(Path(binding['base_prefix'])/'bin')+':/usr/bin:/bin'"),
+    )
+    for raw, expected_expression in expressions:
+        values = [value for node in ast.walk(ast.parse(raw)) if isinstance(node, ast.Dict)
+                  for key, value in zip(node.keys, node.values)
+                  if isinstance(key, ast.Constant) and key.value == 'PATH']
+        if len(values) != 1 or ast.dump(values[0]) != ast.dump(ast.parse(expected_expression, mode='eval').body):
+            raise RuntimeError('PREFLIGHT_CHILD_PATH_POLICY')
+    base_paths = module.p.narrowed_paths(list(sys.path), binding['base_prefix'])
+    wanted = [str(Path(binding['base_prefix'])/'lib/python3.12'),
+              str(Path(binding['base_prefix'])/'lib/python3.12/lib-dynload')]
+    if base_paths != wanted:
+        raise RuntimeError('PREFLIGHT_BASE_PATH_PROOF')
+    mime = module.p.prepare_builtin_mime(binding)
+    if mime != module.p.MIME_RECEIPT:
+        raise RuntimeError('PREFLIGHT_MIME_PROOF')
+    return {'current_narrowed_base_paths': base_paths,
+            'stdlib_origin_validated_builtin_MIME': mime,
+            'prescribed_child_PATH': expected,
+            'child_PATH_matches_frozen_and_diagnostic_source_AST': True,
+            'child_PATH_is_prescribed_not_observed_execution': True}
