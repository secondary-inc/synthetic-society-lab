+def lease_preserved_semantics(historical_release,*,expected_release_hash,valid_from,valid_until):
+    """Lease exact preserved terms; not a fresh price observation or authority.
+
+    Fresh captured catalog bodies may differ from the original interpretation's
+    raw body. Two runtime fresh_proof checks still enforce identical semantics.
+    """
+    need(canonical_hash(historical_release)==expected_release_hash,'slot46 historical release pin')
+    result=deepcopy(historical_release);old=result['terms'];decision=result['interpretation']
+    validate_terms(old);validate_decision(decision)
