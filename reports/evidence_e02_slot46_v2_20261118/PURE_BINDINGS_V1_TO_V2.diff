+         and decision['catalog_sha256']==old['initial_catalog_sha256'],'slot46 preserved interpretation')
+    decision.update(valid_from_utc=valid_from,valid_until_utc=valid_until)
+    old.update(valid_from_utc=valid_from,valid_until_utc=valid_until,interpretation_hash=canonical_hash(decision))
+    validate_terms(old);validate_decision(decision)
+    return result
