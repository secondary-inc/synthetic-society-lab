  "atomic_owner_bridge": {
    "before_transaction": "Persist finite phaseintent/catalogobservation/FP/A/C/GI createonce under fixed originalOwnerDir/v5-runs/PB.fixed_run_id journal anditsrunlock. No ownerSQLwrites. No workspace/outputrootoverride.",
    "credential_stage": "Insideownerlock/SQLiteBEGIN, afterfinalCAS/policy/source/price checks, beforeeventINSERT: validateopaquecredential/transportshape with no request; recheckclock andconstruct/applyallthreeevents.",
    "failure_truth": "SQLite rollback beforecommit ->noauthority/charge iflaterproved; dbcommit-beforeanchor ->tornstore blocksalloriginalwriters; commit+anchor/lostack ->STARTEDreservation retainsfullcharge andunfinishedbarrier. Neverinferabsencefrommissingack.",
    "fixed_run_namespace": "Originalproduction_owner_directory()/v5-runs/<PB.fixed_run_id>, same acrossworktrees. ImmutablemarkerbindsPB/R/O/CS, existingincompleteintentcannothideundernewroot.",
    "lock_order": "Fixedrunlock then originalowner._lock, nonblocking; no pathoverride. AllV5writers use sameorder; legacyV4uses ownerlockonly.",
    "name": "Separatelyversionedproduction_study_owner_v5_1.append_admitted_phase; notexistinggrant_operator_authorization andnot3existing_appendcalls",
    "no_generic_write_interface": "Privateadmittedproofcapabilityonly; no raw SQL/payload/grant hook exposed. Trustedlocalworkflow/codehash boundary, nothostileowner-process guarantee.",
    "storage_compatibility": "SamefixedV4namespace/registration/header/event/charge schemas; existingownerreadermustverify successfultriplet. No newowner/migration/reset. Newbatchwritealgorithm requiresindependentcontrolreview.",
    "transaction": [
      "Acquire originalownerlock; BEGIN IMMEDIATE; original_verify fullhistory/header/anchor/materializedrows.",
      "CAS H(expectedanchor)==FP.expected_owner_head_sha256 andactiveapproval==FP.expected_active_approval_sha256; reverifyowncheckpoint/journal/policy/lease/clock/cap; unfinishedmust0.",
      "Constructandapplyinmemory standardAPPROVAL(A) using original_event/_apply; thenPRICE_PROOF(C); thenRESERVE(originalSTARTEDrow with deterministicreceipt). Allthree mustvalidate beforeINSERT.",
      "INSERT exactlythreechainedstandardevents andonlyoneSTARTEDcharge row inoneSQLite transaction; commitonce. Do NOTcalloriginal_append, which commitsper-event. No APPROVAL-only committedsuccess prefix.",
      "Publish one originalheadanchor forlasttripletevent usingacceptedatomic_json. Anycommit/head/ackfailurehalts; no repair/reset/POST.",
      "Reread original_verify underlock andverifyexactthreeevents/charge/context/approval/proof/receipt plusunchangedpriorrows; recordprivateack. Onlynormalverifiedack returnsdispatchcapability."
    ]
  },
