{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_kind",
    "algorithm",
    "seed",
    "cutoff",
    "expected_race_ids",
    "coverage_status",
    "sources",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_kind": {
      "const": "DEMO_SELECTION_FIXTURE"
    },
    "algorithm": {
      "const": "E01_2026_SELECTION_PROPOSAL_v1"
    },
    "seed": {
      "const": 20261103
    },
    "cutoff": {
      "const": "2026-11-03T04:59:59Z"
    },
    "expected_race_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "coverage_status": {
      "const": "COMPLETE_FIXTURE"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "published_at_utc",
          "amendment_status",
          "first_observed_at_utc",
          "sha256",
          "retrieved_at_utc",
          "revision",
          "url",
          "source_id",
          "reuse_status",
          "asof_status",
          "source_type"
        ],
        "properties": {
          "published_at_utc": {
            "type": "string",
            "minLength": 1
          },
          "amendment_status": {
            "const": "RESOLVED_FIXTURE"
          },
          "first_observed_at_utc": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "retrieved_at_utc": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^fixture://DEMO/"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "reuse_status": {
            "const": "FIXTURE_AUTHORED"
          },
          "asof_status": {
            "const": "VERIFIED_FIXTURE"
          },
          "source_type": {
            "enum": [
              "RATINGS",
              "BALLOT",
              "SEAT_PARTY"
            ]
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "race_id",
          "office",
          "state",
          "district",
          "seat_class",
          "band",
          "sampling_party",
          "eligibility",
          "exclusion_reason",
          "evidence_refs"
        ],
        "properties": {
          "race_id": {
            "type": "string",
            "pattern": "^DEMO-2026-"
          },
          "office": {
            "enum": [
              "HOUSE",
              "SENATE"
            ]
          },
          "state": {
            "enum": [
              "AK",
              "AL",
              "AR",
              "AZ",
              "CA",
              "CO",
              "CT",
              "DE",
              "FL",
              "GA",
              "HI",
              "IA",
              "ID",
              "IL",
              "IN",
              "KS",
              "KY",
              "LA",
              "MA",
              "MD",
              "ME",
              "MI",
              "MN",
              "MO",
              "MS",
              "MT",
              "NC",
              "ND",
              "NE",
              "NH",
              "NJ",
              "NM",
              "NV",
              "NY",
              "OH",
              "OK",
              "OR",
              "PA",
              "RI",
              "SC",
              "SD",
              "TN",
              "TX",
              "UT",
              "VA",
              "VT",
              "WA",
              "WI",
              "WV",
              "WY"
            ]
          },
          "district": {
            "type": "string",
            "minLength": 1
          },
          "seat_class": {
            "type": [
              "integer",
              "null"
            ]
          },
          "band": {
            "enum": [
              "TOSS_UP",
              "LEAN",
              "LIKELY",
              "SOLID"
            ]
          },
          "sampling_party": {
            "enum": [
              "D",
              "R",
              "OTHER"
            ]
          },
          "eligibility": {
            "enum": [
              "ELIGIBLE",
              "EXCLUDED_STRUCTURAL"
            ]
          },
          "exclusion_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e01_selection_fixture_v1",
  "description": "Fixture-only admission schema; source dates/references, canonical identity, exclusions and coverage invariants additionally enforced in validate_fixture. No REAL schema/enabler authorized."
}
